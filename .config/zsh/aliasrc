# 📁 Dir Nav
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias ~='cd ~'


# 🎥 yt-dlp


# 🔍 System & Network Utilities
alias ports='ss -tuln'                                                           # List open ports
alias ipinfo='ip a'                                                              # Show IP addresses
alias topcpu='ps -eo pid,ppid,cmd,%mem,%cpu --sort=-%cpu | head'                 # Top CPU processes
alias meminfo='free -h'                                                          # Memory usage
alias myip='curl ifconfig.me'                                                    # External IP
alias logs='journalctl -xe'                                                      # System logs
alias grep='grep --color=auto'                                                   # Colored grep output
alias df='df -h'                                                                 # Human-readable disk usage
alias du='du -h'                                                                 # Human-readable sizes (du -sh still works)
alias dud='du -h --max-depth=1'                                                  # Sizes of folders one level down
alias mounts='lsblk -o NAME,FSTYPE,SIZE,MOUNTPOINT'                              # Quick view of mounted filesystems
alias up='uptime -p'                                                             # Show how long the system has been running


# 🧪 Tools / Misc
alias ncmp='ncmpcpp'
alias serve='python3 -m http.server 8000'                       # Simple HTTP server
alias copy='xclip -selection clipboard'                         # Copy to clipboard (requires xclip)
alias screencast='ffmpeg -video_size 1920x1080 -framerate 30 -f x11grab -i :0.0 -f pulse -i default -c:v libx264 -preset ultrafast -c:a aac ~/Videos/screencast_$(date +"%Y-%m-%d_%H-%M-%S").mp4'
alias htop='btop'

