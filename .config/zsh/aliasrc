# 🔍 System & Network Utilities
alias ports='ss -tuln'                                                           # List open ports
alias ipinfo='ip a'                                                              # Show IP addresses
alias topcpu='ps -eo pid,ppid,cmd,%mem,%cpu --sort=-%cpu | head'                 # Top CPU processes
alias meminfo='free -h'                                                          # Memory usage
alias myip='curl ifconfig.me'                                                    # External IP
alias logs='journalctl -xe'                                                      # System logs
alias grep='grep --color=auto'                                                   # Colored grep output
alias df='df -h'                                                                 # Human-readable disk usage
alias du='du -h'                                                                 # Human-readable sizes (du -sh still works)
alias dud='du -h --max-depth=1'                                                  # Sizes of folders one level down
alias mounts='lsblk -o NAME,FSTYPE,SIZE,MOUNTPOINT'                              # Quick view of mounted filesystems
alias up='uptime -p'                                                             # Show how long the system has been running


# 🧪 Tools / Misc
alias ncmp='ncmpcpp'
alias serve='python3 -m http.server 8000'                       # Simple HTTP server
alias copy='wl-copy'                                            # Copy to clipboard (Wayland)
alias screencast='wf-recorder --audio -f ~/Videos/screencast_$(date +"%Y-%m-%d_%H-%M-%S").mp4'   # Record screen + mic, Ctrl+C to stop
alias htop='btop'


# 🏠 Dotfiles
# hms = check, then home-manager switch. Use it instead of plain `home-manager switch`.
# What: runs ~/dotfiles/check.sh (home.nix build, Hyprland config, zsh files, update script)
#       and switches only if every check passes.
# Why:  `home-manager switch` only catches home.nix mistakes. A broken Hyprland or zsh file
#       still gets switched in, and you only find out when Hyprland reloads with errors or
#       a new terminal breaks. hms stops before that, so nothing changes until it's fixed.
alias hms='~/dotfiles/check.sh && echo "Switching..." && home-manager switch --flake "$HOME/dotfiles#spandan"'

